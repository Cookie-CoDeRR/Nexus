// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Campaign {
  id           String         @id @default(uuid())
  name         String
  platform     String         // e.g., Meta, Google, LinkedIn
  active       Boolean        @default(true)
  budget       Float?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  metrics      DailyMetrics[]
  leads        Lead[]
}

model DailyMetrics {
  id          String   @id @default(uuid())
  campaignId  String
  date        DateTime
  impressions Int      @default(0)
  clicks      Int      @default(0)
  cost        Float    @default(0.0)
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
}

model Lead {
  id                String    @id @default(uuid())
  leadId            String?   // External CRM identifier (e.g. SLATE-1094, SF-8291)
  email             String
  fullName          String?
  firstName         String?
  lastName          String?
  programOfInterest String?
  sourceChannel     String?   // Meta Ads, Google Search, LinkedIn Ed
  engagementScore   Int       @default(75) // 0 - 100
  campaignId        String?
  syncStatus        String    @default("SYNCED") // PENDING, SYNCED, FAILED
  createdAt         DateTime  @default(now())
  campaign          Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
}

model Archive {
  id                   String   @id @default(uuid())
  campaignGoal         String
  targetAudience       String
  tone                 String
  linkedInCopy         String
  instagramScript      String
  googleSearchHeadline String
  createdAt            DateTime @default(now())
}
